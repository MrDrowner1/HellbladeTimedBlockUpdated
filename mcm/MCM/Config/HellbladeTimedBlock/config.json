{
    "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
    "modName": "HellbladeTimedBlock",
    "displayName": "Hellblade - Timed Block",
    "cursorFillMode": "topToBottom",
    "content": [
        { 
            "text": "Timed Block Options", 
            "type": "header" 
        },
        { 
            "id": "bTimedBlockEnabled:Settings",
            "text": "Enable Timed Block", 
            "type": "toggle", 
            "groupControl": 1,
            "valueOptions": { 
                "defaultValue": true,
                "sourceType": "ModSettingBool"
            }
        },
        { 
            "id": "fTimedBlockWindow:Settings",
            "text": "Time Window",
            "type": "slider",
            "groupCondition": 1,
            "help": "The maximum length of time, after raising a shield or weapon, that the player is able to perform a timed block.",
            "valueOptions": {
                "min": 0.1,
                "max": 2.0,
                "step": 0.1,
                "defaultValue": 0.2,
                "formatString": "{2} Seconds",
                "sourceType": "ModSettingFloat"
            }
        },
        {
            "id": "fTimedBlockSlowdownDuration:Settings",
            "text": "Duration",
            "type": "slider",
            "groupCondition": 1,
            "help": "The duration of the slowed time following a successful timed block.",
            "valueOptions": {
                "min": 0.3,
                "max": 1.0,
                "step": 0.1,
                "defaultValue": 0.6,
                "formatString": "{2} Seconds",
                "sourceType": "ModSettingFloat"
            }
        },
        {
            "id": "fTimedBlockSlowdownMult:Settings",
            "text": "Time Scale",
            "type": "slider",
            "groupCondition": 1,
            "help": "How fast time runs at the peak of the slowdown after a timed block, 1.0 is normal speed.",
            "valueOptions": {
                "min": 0.1,
                "max": 1.0,
                "step": 0.05,
                "defaultValue": 0.6,
                "formatString": "{2}",
                "sourceType": "ModSettingFloat"
            }
        },
        { 
            "text": "Perfect Block Options", 
            "type": "header",
            "position": 1
        },
        { 
            "id": "bPerfectBlockEnabled:Settings",
            "text": "Enable Perfect Block", 
            "type": "toggle", 
            "groupControl": 2,
            "valueOptions": { 
                "defaultValue": true,
                "sourceType": "ModSettingBool"
            }
        },
        { 
            "id": "fPerfectBlockWindow:Settings",
            "text": "Time Window",
            "type": "slider",
            "groupCondition": 2,
            "help": "The maximum length of time, after raising a shield or weapon, that the player is able to perform a perfect block.",
            "valueOptions": {
                "min": 0.05,
                "max": 1.0,
                "step": 0.05,
                "defaultValue": 0.05,
                "formatString": "{2} Seconds",
                "sourceType": "ModSettingFloat"
            }
        },
        {
            "id": "fPerfectBlockSlowdownDuration:Settings",
            "text": "Duration",
            "type": "slider",
            "groupCondition": 2,
            "help": "The duration of the slowed time following a successful perfect block.",
            "valueOptions": {
                "min": 1.0,
                "max": 3.0,
                "step": 0.1,
                "defaultValue": 1.2,
                "formatString": "{2} Seconds",
                "sourceType": "ModSettingFloat"
            }
        },
        {
            "id": "fPerfectBlockSlowdownMult:Settings",
            "text": "Time Scale",
            "type": "slider",
            "groupCondition": 2,
            "help": "How fast time runs at the peak of the slowdown after a perfect block, 1.0 is normal speed.",
            "valueOptions": {
                "min": 0.1,
                "max": 1.0,
                "step": 0.05,
                "defaultValue": 0.4,
                "formatString": "{2}",
                "sourceType": "ModSettingFloat"
            }
        },
        {
            "type": "empty"
        },
        {
            "id": "bPerfectBlockDamageMultEnabled:Settings",
            "text": "Enable Damage Multiplier",
            "type": "toggle",
            "groupControl": 3,
            "groupCondition": 2,
            "help": "Weapon damage will be increased for a period of time after performing a perfect block.",
            "valueOptions": { 
                "defaultValue": true,
                "sourceType": "ModSettingBool"
            }
        },
        {
            "id": "iPerfectBlockDamageMultDuration:Settings",
            "text": "Multiplier Duration",
            "type": "slider",
            "groupCondition": {
                "AND": [2, 3]
            },
            "help": "The length of time that the players attack damage will be increased for.",
            "valueOptions": {
                "min": 1,
                "max": 6,
                "step": 1,
                "defaultValue": 4,
                "formatString": "{0} Seconds",
                "sourceType": "ModSettingInt"
            }
        },
        {
            "id": "fPerfectBlockDamageMult:Settings",
            "text": "Damage Multiplier",
            "type": "slider",
            "groupCondition": {
                "AND": [2, 3]
            },
            "help": "How many times the player's attack damage is multiplied while the boost lasts.",
            "valueOptions": {
                "min": 1.0,
                "max": 5.0,
                "step": 0.1,
                "defaultValue": 2.0,
                "formatString": "{1}x",
                "sourceType": "ModSettingFloat"
            }
        },
        {
            "type": "empty"
        },
        { 
            "text": "Miscellaneous", 
            "type": "header" 
        },
        { 
            "id": "fCooldownTime:Settings",
            "text": "Cooldown Time",
            "type": "slider",
            "groupCondition": 2,
            "help": "The amount of time that has to pass before another timed block can be performed.",
            "valueOptions": {
                "min": 0.0,
                "max": 1.0,
                "step": 0.05,
                "defaultValue": 0.0,
                "formatString": "{2} Seconds",
                "sourceType": "ModSettingFloat"
            }
        }
    ]
}